{
  "name": "flolux",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspace=apps/web && cp -r apps/web/dist apps/api/public",
    "start": "npm run start --workspace=apps/api",
    "postinstall": "npm run prisma:generate --workspace=apps/api"
  }
}
