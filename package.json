{
  "name": "flolux-monorepo",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace apps/web",
    "dev:api": "npm run dev --workspace apps/api",
    "build": "npm run build --workspace apps/web && npm run copy:web --workspace apps/api",
    "start": "npm run start --workspace apps/api"
  }
}
