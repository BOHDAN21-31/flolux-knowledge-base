# Підключення до PostgreSQL (Railway підставить автоматично через DATABASE_URL)
DATABASE_URL="postgresql://user:password@localhost:5432/flolux?schema=public"

# Секрет для підпису JWT (обовʼязково задати у проді)
JWT_SECRET="change-me-to-a-long-random-string"

# Реферальне слово для реєстрації
REFERRAL_WORD="Flolux"

# Перший адмін (створюється при порожній БД)
ADMIN_EMAIL="admin@flolux.local"
ADMIN_PASSWORD="admin12345"
ADMIN_NAME="Адміністратор"

# Порт (Railway підставляє свій $PORT)
PORT=3001
