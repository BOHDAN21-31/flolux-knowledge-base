# Підключення до PostgreSQL (Railway підставить через DATABASE_URL)
DATABASE_URL=

# Секрет для підпису JWT (обовʼязково задати у проді)
JWT_SECRET=

# Порт HTTP-сервера
PORT=3000

# WebAuthn (Touch/Face ID)
RP_ID=localhost
RP_NAME=Flolux
ORIGIN=http://localhost:5173

# Том для завантажених файлів (Railway Volume)
RAILWAY_VOLUME_MOUNT_PATH=/data

# Telegram-бот (значення задається у Railway Variables, НЕ тут)
TELEGRAM_BOT_TOKEN=
# Опціонально: секрет для перевірки webhook (якщо порожньо — перевірка пропускається)
TELEGRAM_WEBHOOK_SECRET=
