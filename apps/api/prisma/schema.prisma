datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  requestedRole String?
  assignedRole  String?
  approved      Boolean      @default(false)
  createdAt     DateTime     @default(now())
  articles      Article[]
  comments      Comment[]
  suggestions   Suggestion[]
}

model Topic {
  id          String    @id
  roleKey     String
  title       String
  description String
  createdAt   DateTime  @default(now())
  articles    Article[]

  @@index([roleKey])
}

model Article {
  id          String       @id @default(cuid())
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id])
  section     String
  title       String
  content     String
  tags        String[]
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  comments    Comment[]
  suggestions Suggestion[]

  @@index([topicId])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([articleId])
}

model Suggestion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([articleId])
}
