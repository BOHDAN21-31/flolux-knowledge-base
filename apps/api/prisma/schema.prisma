datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  surname       String?
  avatarUrl     String?
  phone         String?
  rating        Int          @default(0)
  requestedRole String?
  // DEPRECATED: тримається для зворотної сумісності (serialize.js, бейджі ролі).
  // Авто-синхронізується до "первинної" ролі (admin або перша з roles).
  assignedRole  String?
  approved      Boolean      @default(false)
  birthday      DateTime?    @db.Date
  telegramChatId   String?   @unique
  telegramUsername String?
  telegramLinkCode String?    @unique
  telegramLinkedAt DateTime?
  createdAt     DateTime     @default(now())
  articles      Article[]
  comments      Comment[]
  suggestions   Suggestion[]
  locations     UserLocation[]
  locationReqs  LocationRequest[]
  webauthn      WebAuthnCredential[]
  roles         UserRole[]
  suggestionRatings SuggestionRating[]
  auditLogs     AuditLog[]
  bookmarks     Bookmark[]
  views         ArticleView[]
  notificationsReceived Notification[] @relation("notifRecipient")
  notificationsSent     Notification[] @relation("notifActor")
  notificationPref      NotificationPreference?
  permissions           UserPermission[]
  announcements         Announcement[]
  announcementReads     AnnouncementRead[]
  docs                  CompanyDoc[]
  docVersions           DocVersion[]
  docAcknowledgements   DocAcknowledgement[]
}

model Announcement {
  id              String              @id @default(cuid())
  title           String
  body            String
  category        String
  priority        String              @default("normal")
  authorId        String
  author          User                @relation(fields: [authorId], references: [id], onDelete: Cascade)
  targetRoles     String[]
  targetLocations String[]
  expiresAt       DateTime?
  pinned          Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  reads           AnnouncementRead[]

  @@index([createdAt])
  @@index([pinned])
  @@index([expiresAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
}

// Корпоративні документи (правила, SOP) — з версіями та підтвердженням прочитання.
model CompanyDoc {
  id                    String                @id @default(cuid())
  slug                  String                @unique
  title                 String
  description           String?
  category              String
  iconKey               String?
  color                 String?
  currentVersion        Int                   @default(1)
  publishedAt           DateTime?
  mandatoryForRoles     String[]              @default([])
  mandatoryForLocations String[]              @default([])
  authorId              String?
  author                User?                 @relation(fields: [authorId], references: [id], onDelete: SetNull)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  sections              DocSection[]
  versions              DocVersion[]
  acknowledgements      DocAcknowledgement[]

  @@index([category])
  @@index([publishedAt])
}

model DocSection {
  id        String       @id @default(cuid())
  docId     String
  parentId  String?
  title     String
  body      String?
  orderIdx  Int          @default(0)
  level     Int          @default(1)
  createdAt DateTime     @default(now())
  doc       CompanyDoc   @relation(fields: [docId], references: [id], onDelete: Cascade)
  parent    DocSection?  @relation("DocSectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocSection[] @relation("DocSectionTree")

  @@index([docId, parentId, orderIdx])
}

model DocVersion {
  id         String     @id @default(cuid())
  docId      String
  version    Int
  snapshot   Json
  changedBy  String?
  changeNote String?
  createdAt  DateTime   @default(now())
  doc        CompanyDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [changedBy], references: [id], onDelete: SetNull)

  @@unique([docId, version])
  @@index([docId])
}

model DocAcknowledgement {
  id                  String     @id @default(cuid())
  docId               String
  userId              String
  versionAcknowledged Int
  acknowledgedAt      DateTime   @default(now())
  ipAddress           String?
  doc                 CompanyDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([docId, userId, versionAcknowledged])
  @@index([docId])
  @@index([userId])
}

// Каталог дозволів (індивідуальні права поверх ролей).
model Permission {
  key         String           @id
  category    String // content | users | locations | system
  name        String
  description String?
  protected   Boolean          @default(false)
  users       UserPermission[]
}

// Індивідуальний дозвіл користувача (опційно з терміном дії).
model UserPermission {
  id            String     @id @default(cuid())
  userId        String
  permissionKey String
  grantedBy     String?
  grantedAt     DateTime   @default(now())
  expiresAt     DateTime?
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionKey], references: [key], onDelete: Cascade)

  @@unique([userId, permissionKey])
  @@index([userId])
}

// Іменований набір дозволів для швидкого застосування.
model PermissionPreset {
  id             String   @id @default(cuid())
  name           String
  description    String?
  permissionKeys String[]
  createdBy      String?
  createdAt      DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  recipientId String
  recipient   User      @relation("notifRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String?
  linkPath    String?
  actorId     String?
  actor       User?     @relation("notifActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  newArticleAll        Boolean  @default(true)
  newArticleMyRole     Boolean  @default(true)
  newArticleMyLocation Boolean  @default(true)
  comments             Boolean  @default(true)
  suggestions          Boolean  @default(true)
  suggestionApproved   Boolean  @default(true)
  birthdays            Boolean  @default(true)
  digests              Boolean  @default(true)
  roleChanges          Boolean  @default(true)
  locationChanges      Boolean  @default(true)
  telegramEnabled      Boolean  @default(true)
  announcementsAll        Boolean @default(true)
  announcementsUrgentOnly Boolean @default(false)
  updatedAt            DateTime @default(now()) @updatedAt
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  role      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role])
}

model Role {
  key         String   @id
  name        String
  description String?
  iconKey     String?
  color       String?
  protected   Boolean  @default(false)
  restricted  Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Topic {
  id          String    @id
  roleKey     String
  title       String
  description String
  icon        String?
  createdAt   DateTime  @default(now())
  articles    Article[]

  @@index([roleKey])
}

model Article {
  id          String       @id @default(cuid())
  topicId     String
  topic       Topic        @relation(fields: [topicId], references: [id])
  section     String
  title       String
  content     String
  tags        String[]
  mediaUrls   String[]     @default([])
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  status      String       @default("published")
  publishAt   DateTime?
  notifyMode  String?
  notifyTargets Json?
  notifiedAt  DateTime?
  isDigest    Boolean      @default(false)
  digestCategory String?
  comments    Comment[]
  suggestions Suggestion[]
  locations   ArticleLocation[]
  bookmarks   Bookmark[]
  views       ArticleView[]

  @@index([topicId])
  @@index([status])
  @@index([publishAt])
  @@index([isDigest])
}

model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  userId    String
  viewedAt  DateTime @default(now())
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@index([userId])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  articleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  createdAt DateTime @default(now())

  @@index([articleId])
}

model Suggestion {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  ratings   SuggestionRating[]

  @@index([articleId])
}

model SuggestionRating {
  id           String     @id @default(cuid())
  suggestionId String
  userId       String
  rating       Int
  createdAt    DateTime   @default(now())
  suggestion   Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Cascade)
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
}

model Location {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  color     String?
  city      String?
  address   String?
  active    Boolean           @default(true)
  createdAt DateTime          @default(now())
  users     UserLocation[]
  requests  LocationRequest[]
  articles  ArticleLocation[]
}

model UserLocation {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  isManager  Boolean  @default(false)
  approved   Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model LocationRequest {
  id         String   @id @default(cuid())
  userId     String
  locationId String
  status     String   @default("pending")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
}

model ArticleLocation {
  id         String   @id @default(cuid())
  articleId  String
  locationId String
  article    Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([articleId, locationId])
}

model WebAuthnCredential {
  id           String   @id @default(cuid())
  userId       String
  credentialId String   @unique
  publicKey    Bytes
  counter      Int      @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
