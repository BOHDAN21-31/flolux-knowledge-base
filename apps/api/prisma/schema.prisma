generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  requestedRole String?
  assignedRole  String?
  approved      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  articles    Article[]
  comments    Comment[]
  suggestions Suggestion[]
}

model Topic {
  id          String   @id @default(cuid())
  roleKey     String
  title       String
  description String?
  createdAt   DateTime @default(now())

  @@index([roleKey])
}

model Article {
  id        String   @id @default(cuid())
  topicId   String?
  section   String
  title     String
  content   String
  tags      String[] @default([])
  authorId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author      User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments    Comment[]
  suggestions Suggestion[]

  @@index([topicId])
  @@index([section])
}

model Comment {
  id        String   @id @default(cuid())
  articleId String
  authorId  String?
  content   String
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId])
}

model Suggestion {
  id        String   @id @default(cuid())
  articleId String
  authorId  String?
  content   String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author  User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([articleId])
  @@index([status])
}
